@{
	ViewData["Title"] = "Home Page";
}

@model QuestionModel

<form asp-action="Next" asp-controller="Quiz" method="post">
	@if(ViewBag.IsWrong != null && ViewBag.IsWrong)
	{
		<!-- Кнопка для открытия модального окна -->
		<button style="display:none" type="button" id="mbtn" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#answerModal">Открыть модальное окно</button>

		<!-- Само модальное окно -->
		<div class="modal fade" id="answerModal" tabindex="-1" aria-labelledby="answerModalLabel" aria-hidden="true">
			<div class="modal-dialog modal-dialog-centered">
				<div class="modal-content">
					<div class="modal-header">
						<h5 class="modal-title" id="answerModalLabel">Правильный ответ</h5>
						<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
					</div>
					<div class="modal-body">
						@ViewBag.RightAnswerText
					</div>
				</div>
			</div>
		</div>

		<script>
			window.onload = () => {
				document.getElementById("mbtn").click();
			}
			//alert(`Правильный ответ ${@ViewBag.RightAnswerText}`);
		</script>
	}
	<div style="padding: 3vh">
		<h1 class="text-center">@TempData["VictorinaTitle"]</h1>
		<hr />
		<div>
	<div style="display:flex; flex-direction:column; align-items:center" class="text-center">
		<div class="quiz-card">
			<img class="quiz-card-img" src="@Model.ImgUrl" alt="@Model.Title">
			<h5 class="card-title">@Model.Title</h5>
		</div>
		
		<div class="container">
			@for (int i = 0; i < 2; i++)
			{
				<div class="row justify-content-md-center">
					@for (int j = i * 2; j < 2 + (2 * i); j++)
					{
						<button id="@(j+1)"
			  type="button"
			  class="answer-button col-1 btn m-3 btn-sm btn-primary"
			  onclick="changeButtonState(event)">@Model.Answers[j]</button>
					}
				</div>
			}
		</div>
		@*@for (int i = 0; i < Model.Answers.Length; i++)
		{
		<button id="@(i+1)" type="button" class="answer-button" onclick="changeButtonState(event)">@Model.Answers[i]</button>
		}*@
		<input name="userChoiceIndex" type="hidden" value="">
		<button class="btn btn-outline-info" type="submit">Следующий вопрос</button>
	</div>
</form>