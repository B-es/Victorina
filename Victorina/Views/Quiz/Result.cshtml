
@{

}

@model QuizResultModel

<div style="padding: 3vh">
	<h1 class="text-center">@TempData["VictorinaTitle"]</h1>
	<hr />
	<div>
<div class="container">
	<div class="row justify-content-center">
		<h2 class="col-md-auto">Правильных ответов @Model.RightCount из @Model.AllCount</h2>
	</div>
	<div class="row justify-content-center">
		@for (int i = 0; i < Model.StarsCount; i++)
		{
			<div class="col-md-auto">✪</div>
		}
	</div>
	<a class="row justify-content-center" asp-controller="Quiz" asp-action="StartNewVictorina">Начать заново</a>
	<a class="row justify-content-center" asp-controller="Menu" asp-action="Index">Вернуться в меню</a>
</div>
